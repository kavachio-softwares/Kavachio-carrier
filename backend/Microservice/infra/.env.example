# Shared config for the local microservices stack (infra/docker-compose.yml).
# Copy to infra/.env:  cp .env.example .env
# NOTE: this file intentionally ships with WORKING values so the team can run the
# stack immediately. Change the secrets below for any real/production deployment.

# --- Shared database: EXTERNAL / managed PostgreSQL (one DB for all services) ---
# Connects as the superuser (bypasses Row-Level Security, like the old backend).
# The kavachio_app role only works with KAVACHIO_RLS=on (per-request tenant stamping).
DATABASE_URL=postgresql+psycopg2://postgres:postgres123@192.168.2.11:5432/kavachio_carrier
# Local-dev only: to use the throwaway container instead, run
#   docker compose --profile localdb up
# and set: DATABASE_URL=postgresql+psycopg2://postgres:postgres123@postgres:5432/kavachio

# --- Auth (names match shared/core/settings.py) ---
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
JWT_ISSUER=kavachio-auth
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=7

# --- Background jobs ---
REDIS_URL=redis://redis:6379/0
JOB_WORKERS=4

# --- Inter-service HTTP (shared/lib/clients.py). Defaults already match the
#     compose service names, so these are only needed to override. ---
AUTH_URL=http://auth-service:8001
TENANT_ADMIN_URL=http://tenant-admin-service:8007
MAPPER_URL=http://mapper-service:8002
INGESTION_URL=http://ingestion-service:8003
VALIDATION_URL=http://validation-service:8004
EXPORT_URL=http://export-service:8005
CONTRACT_URL=http://contract-service:8006
SERVICE_HTTP_TIMEOUT=1800   # 30 min; matches gateway proxy_read_timeout
# SERVICE_TOKEN=            # optional shared secret for service-to-service auth

# --- File storage ---
# Default "db": uploaded files are stored as BYTEA blobs in PostgreSQL (no extra
# infra needed). Set STORAGE_BACKEND=azure to store them in Azure Blob instead
# (Azurite locally, real Azure in prod). Old DB-blob rows still resolve either way.
STORAGE_BACKEND=db
# Only used when STORAGE_BACKEND=azure. The default below is Azurite's public dev
# connection string; run  bash scripts/start-azurite.sh  (or the azurite compose
# profile) for a local blob store. In prod, set your real Azure connection string.
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=kavachio-uploads
# AZURE_BLOB_PREFIX=            # optional virtual folder prefix inside the container

# --- LLM ---
GEMINI_API_KEY=
# --- Tracing (optional; set an OTLP endpoint to enable OpenTelemetry) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
